
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Lecture: utilisateurs authentifiés (nécessaire pour le script qui liste les URLs des images).
    // Écriture: réservée à l'admin, pour éviter que tout utilisateur connecté puisse écraser des fichiers.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'weblinecreation88@gmail.com';
    }
  }
}
