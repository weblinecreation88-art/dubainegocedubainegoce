# ═════════════════════════════════════════════════════════════════════════════
# PATTERN: REDIRECT CHAIN FIX
# ═════════════════════════════════════════════════════════════════════════════

# ❌ AVANT (Chaîne: A → B → C → D):
#    Page A → /page/old → /products/old-name → /shop/product-123
#    (4 redirects = 0.5-2 secondes perdues!)

# ✅ APRÈS (Direct: A → D):
#    Page A → /shop/product-123 (1 redirect direct)

# ═════════════════════════════════════════════════════════════════════════════
# EXEMPLE 1: Redirect Chaîne Produit
# ═════════════════════════════════════════════════════════════════════════════

# Chaîne identifiée: /old-produit → /produits/ancien → /shop/ancien-produit → /produits/final
RewriteCond %{REQUEST_URI} ^/old-produit/?$
RewriteRule ^(.*)$ https://dubainegoce.fr/produits/final [R=301,L]

# Chaîne identifiée: /product-xyz → /category/xyz → /products/xyz-final
RewriteCond %{REQUEST_URI} ^/product-xyz/?$
RewriteRule ^(.*)$ https://dubainegoce.fr/products/xyz-final [R=301,L]

# Chaîne identifiée: /item-old → /items/old → /items/updated
RewriteCond %{REQUEST_URI} ^/item-old/?$
RewriteRule ^(.*)$ https://dubainegoce.fr/items/updated [R=301,L]

# ═════════════════════════════════════════════════════════════════════════════
# EXEMPLE 2: Redirect Chaîne Catégorie
# ═════════════════════════════════════════════════════════════════════════════

# Chaîne: /categorie-ancienne → /cat/old → /categories/new
RewriteCond %{REQUEST_URI} ^/categorie-ancienne/?$
RewriteRule ^(.*)$ https://dubainegoce.fr/categories/new [R=301,L]

# Chaîne: /shop/old-cat → /categories/old-cat → /cat/new-cat
RewriteCond %{REQUEST_URI} ^/shop/old-cat/?$
RewriteRule ^(.*)$ https://dubainegoce.fr/cat/new-cat [R=301,L]

# ═════════════════════════════════════════════════════════════════════════════
# EXEMPLE 3: Redirect Chaîne Pages de Contenu
# ═════════════════════════════════════════════════════════════════════════════

# Chaîne: /blog/old-post → /articles/old → /blog/articles/final
RewriteCond %{REQUEST_URI} ^/blog/old-post/?$
RewriteRule ^(.*)$ https://dubainegoce.fr/blog/articles/final [R=301,L]

# Chaîne: /page/old → /pages/old → /help/old → /support/faq
RewriteCond %{REQUEST_URI} ^/page/old/?$
RewriteRule ^(.*)$ https://dubainegoce.fr/support/faq [R=301,L]

# ═════════════════════════════════════════════════════════════════════════════
# EXEMPLE 4: Redirect Chaînes Avec Paramètres
# ═════════════════════════════════════════════════════════════════════════════

# Chaîne: /product.php?id=123 → /products/123 → /products/123-name
RewriteCond %{REQUEST_URI} ^/product\.php$
RewriteCond %{QUERY_STRING} ^id=(.*)$
RewriteRule ^(.*)$ https://dubainegoce.fr/products/%1-final [R=301,L]

# ═════════════════════════════════════════════════════════════════════════════
# EXEMPLE 5: Redirect URLs Anciennes Versions Site
# ═════════════════════════════════════════════════════════════════════════════

# Migration WooCommerce vers custom:
RewriteCond %{REQUEST_URI} ^/woocommerce/product/(.*)$
RewriteRule ^(.*)$ https://dubainegoce.fr/products/$1 [R=301,L]

# Redirection dossier ancien:
RewriteCond %{REQUEST_URI} ^/old-shop/(.*)$
RewriteRule ^(.*)$ https://dubainegoce.fr/shop/$1 [R=301,L]

# ═════════════════════════════════════════════════════════════════════════════
# EXEMPLE 6: Bulk Redirects (Expressions Régulières)
# ═════════════════════════════════════════════════════════════════════════════

# Tout ce qui commence par /old- vers /new-:
RewriteCond %{REQUEST_URI} ^/old-(.*)$
RewriteRule ^(.*)$ https://dubainegoce.fr/new-%1 [R=301,L]

# Tout ce qui commence par /products-old vers /products:
RewriteCond %{REQUEST_URI} ^/products-old/(.*)$
RewriteRule ^(.*)$ https://dubainegoce.fr/products/$1 [R=301,L]

# ═════════════════════════════════════════════════════════════════════════════
# TEST & VÉRIFICATION
# ═════════════════════════════════════════════════════════════════════════════

# Pour chaque redirect, tester avec:

# ✅ Redirection simple (1 hop):
# curl -I https://dubainegoce.fr/old-produit
# Expected: 301 Moved Permanently
# Location: https://dubainegoce.fr/produits/final

# ✅ Suivi de redirection (devrait être 1 seul):
# curl -I -L https://dubainegoce.fr/old-produit
# Expected: 200 OK (après 1 seul redirect)

