# 3. WWW cohérence
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_HOST} ^www\.dubainegoce\.fr [NC]
#   RewriteRule ^(.*)$ https://dubainegoce.fr/$1 [L,R=301]
# </IfModule>

# 4. CORRECTION CHAÎNES REDIRECTION (CETTE SECTION)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   [Ajouter toutes les règles de redirects directes ici]
# </IfModule>

# 5. Compression, cache, sécurité, etc.
